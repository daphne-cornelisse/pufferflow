# Data. The bottleneck map is tracked so tests can load it.
# The four mixed CARLA maps are the drive sweep: Town01, Town02,
# Town06, Town10HD. data/i24 is the three-scene highway release:
# processed logs, map binaries, and the raw BMVC files.
# Videos and plots under assets/ stay local.
data/*
!data/i24/
data/i24/assets/
data/i24/**/.~lock.*
!data/bottleneck/
data/bottleneck/*
!data/bottleneck/binaries/
data/bottleneck/binaries/*
!data/bottleneck/binaries/map_000.bin
!data/mixed/
data/mixed/*
!data/mixed/binaries/
data/mixed/binaries/*
!data/mixed/binaries/map_000.bin
!data/mixed/binaries/map_001.bin
!data/mixed/binaries/map_002.bin
!data/mixed/binaries/map_003.bin
